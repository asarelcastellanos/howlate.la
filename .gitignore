# Generated by tools, never written by hand
.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Collected data. This belongs in cloud storage, not in git: it grows by about a
# gigabyte a day and would bloat the repo permanently.
data/
# The site's data loader and its generated types live in a folder of this name.
!web/src/lib/data/
*.jsonl
*.jsonl.gz
*.jsonl.raw
*.parquet

# The site
node_modules/
web/dist/
web/build/
web/.svelte-kit/

# Pipeline output. Derived from the archive and rebuilt by a command, so it is
# never worth committing.
out/
site/
.cache/

# Working notes and incident write-ups. About the running system rather than the
# code, and deliberately not published.
*.local.md
