# Generated by tools, never written by hand
.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Collected data. This belongs in cloud storage, not in git: it grows by about a
# gigabyte a day and would bloat the repo permanently.
data/
*.jsonl
*.jsonl.gz
*.jsonl.raw
*.parquet

# The site
node_modules/
web/dist/
web/build/

# Pipeline output. Derived from the archive and rebuilt by a command, so it is
# never worth committing.
out/
site/
.cache/
