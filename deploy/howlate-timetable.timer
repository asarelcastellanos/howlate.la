[Unit]
Description=Check Metro's timetable four times a day

[Timer]
# Every 6 hours rather than daily. The check is a HEAD request costing a few
# hundred bytes, and checking more often shrinks the window in which a VM
# outage could overlap a Metro republish and miss a schedule version for good.
OnCalendar=*-*-* 00,06,12,18:10:00 UTC

# Spread the actual run over 20 minutes so we are not hitting GitLab at
# precisely the same second as everyone else with the same idea.
RandomizedDelaySec=1200

# If the machine was off when a run was due, run it once on boot instead of
# silently skipping it.
Persistent=true

[Install]
WantedBy=timers.target
