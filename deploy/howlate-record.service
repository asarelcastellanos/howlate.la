[Unit]
Description=HowLate recorder: listens to Metro's live feed
After=network-online.target
Wants=network-online.target
# Never stop trying to restart, no matter how many times it has failed.
StartLimitIntervalSec=0

[Service]
User=howlate
WorkingDirectory=/var/lib/howlate
ExecStart=/opt/howlate/venv/bin/python -u -m howlate.record

# The recorder reconnects on its own, so a crash here means something
# unexpected. Restart regardless and let it recover the open file on startup.
Restart=always
RestartSec=5

# systemd sends SIGTERM to stop us, which record.py handles by finishing the
# open file. Give it room to do that rather than killing it mid-write.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
