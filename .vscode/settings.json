{
  // Generated by tools, never edited by hand, never committed. Hidden from the
  // file tree so only files you actually wrote show up.
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.DS_Store": true,
    ".venv": true
  },

  // Use the project's virtualenv, so imports resolve and the right Python runs.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Don't search inside generated folders.
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    ".venv": true
  }
}
