{
  "rule": [
    {
      "action": {"type": "SetStorageClass", "storageClass": "COLDLINE"},
      "condition": {
        "age": 30,
        "matchesPrefix": ["vehicle_positions/"],
        "matchesStorageClass": ["STANDARD"]
      }
    },
    {
      "action": {"type": "SetStorageClass", "storageClass": "ARCHIVE"},
      "condition": {
        "age": 365,
        "matchesPrefix": ["vehicle_positions/"],
        "matchesStorageClass": ["COLDLINE"]
      }
    }
  ]
}
