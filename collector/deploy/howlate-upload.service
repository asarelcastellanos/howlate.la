[Unit]
Description=HowLate uploader: ships finished files to Cloud Storage
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=howlate
WorkingDirectory=/var/lib/howlate
ExecStart=/opt/howlate/venv/bin/python -u -m howlate_collector.upload

# No EnvironmentFile: the uploader has no heartbeat. Its failures are visible in
# the spool directory filling up, and it authenticates through the instance's
# own service account rather than any secret.
Restart=always
RestartSec=15

KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
