{
	"name": "howlate-web",
	"version": "0.5.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node --test tests/built.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"types": "node scripts/generate-types.mjs",
		"lines:refresh": "node scripts/refresh-lines.ts",
		"test": "node --import ./tests/register.mjs --test tests/contrast.test.ts tests/types.test.ts tests/load.test.ts tests/charts.test.ts tests/chartLabels.test.ts tests/routeChart.test.ts tests/readout.test.ts tests/methods.test.ts tests/behind.test.ts tests/search.test.ts tests/linePage.test.ts tests/service.test.ts tests/ranking.test.ts tests/ontimeNote.test.ts tests/methodsShares.test.ts tests/rankingShape.test.ts tests/nav.test.ts tests/pageHead.test.ts tests/lineHead.test.ts tests/lineRedirects.test.ts tests/config.test.ts tests/home.test.ts tests/testScript.test.ts && node --conditions=browser --import ./tests/client.mjs --test tests/boundary.test.ts",
		"e2e": "playwright test --config e2e/playwright.config.ts",
		"e2e:stage": "node e2e/stage.mjs",
		"lighthouse": "cd e2e && lhci autorun --config lighthouserc.cjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/source-serif-4": "5.3.1",
		"@lhci/cli": "0.16.1",
		"@lucide/svelte": "1.73.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"cn": "0.5.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"json-schema-to-typescript": "16.0.0",
		"linkedom": "0.18.15",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"shadcn-svelte": "1.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.2",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8"
	},
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"@observablehq/plot": "0.6.19"
	}
}
